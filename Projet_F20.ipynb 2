        "from sklearn.dummy import DummyClassifier\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --- 1. Entraînement de l'algorithme principal (GMM / Code 21) ---\n",
        "# Instanciation et ajustement du GMM sur les données d'entraînement réduites par ACP\n",
        "gmm = GaussianMixture(n_components=3, covariance_type='full', random_state=42)\n",
        "gmm.fit(X_train_pca)\n",
        "labels_train = gmm.predict(X_train_pca)\n",
        "\n",
        "# --- 2. Comparaison avec une règle de référence naïve ---\n",
        "# Baseline naïve (stratification aléatoire ou classe majoritaire adaptée au clustering)\n",
        "dummy = DummyClassifier(strategy=\"most_frequent\")\n",
        "dummy.fit(X_train, y_train)\n",
        "dummy_preds = dummy.predict(X_train)\n",
        "\n",
        "# --- 3. Réglage des hyperparamètres par Validation Croisée ---\n",
        "# Recherche du meilleur nombre de composants (K) via validation croisée (sur score BIC)\n",
        "best_bic = np.inf\n",
        "best_k = 3\n",
        "for k in range(2, 6):\n",
        "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
        "    bics = []\n",
        "    # Note: Le GMM étant non supervisé, on évalue la log-vraisemblance moyenne ou le BIC\n",
        "    temp_gmm = GaussianMixture(n_components=k, covariance_type='full', random_state=42)\n",
        "    temp_gmm.fit(X_train_pca)\n",
        "    bics.append(temp_gmm.bic(X_train_pca))\n",
        "\n",
        "    if np.mean(bics) < best_bic:\n",
