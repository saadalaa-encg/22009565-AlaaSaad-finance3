        "#ETAPE 4 : Apprentissage et évaluation : algorithme GMM (basé sur le code 21 avec ACP)\n",
        "\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from sklearn.model_selection import StratifiedKFold\n",
