        "# --- ÉTAPE 2 : Jeu de données et Prétraitement (ACP) ---\n",
        "from sklearn.datasets import load_wine\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# Chargement et standardisation\n",
        "data = load_wine()\n",
        "X_scaled = StandardScaler().fit_transform(data.data)\n",
        "\n",
        "# Réduction de dimension par ACP\n",
        "pca = PCA(n_components=2, random_state=42)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "print('Variance expliquée par l’ACP :', pca.explained_variance_ratio_.round(3))\n",
        "\n",
        "# Apprentissage (Mélanges Gaussiens / GMM) ---\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "# Entraînement du modèle GMM\n",
        "gmm = GaussianMixture(n_components=3, covariance_type='full', random_state=42)\n",
        "gmm.fit(X_pca)\n",
        "\n",
        "# Prédictions et probabilités (Soft clustering)\n",
        "labels = gmm.predict(X_pca)\n",
        "probabilities = gmm.predict_proba(X_pca)\n",
        "\n",
        "# Évaluation\n",
        "score = silhouette_score(X_pca, labels)\n",
        "print(f\"Score de silhouette : {score:.3f}\")\n"
